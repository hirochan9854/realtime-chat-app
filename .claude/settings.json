{
	"effortLevel": "high",
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(npx *)",
			"Bash(git *)",
			"Bash(gh *)",
			"Bash(date *)",
			"Bash(ls *)",
			"Bash(cat *)",
			"Bash(find *)",
			"Bash(grep *)",
			"Bash(mkdir *)",
			"Bash(cp *)",
			"Read",
			"Write",
			"Edit",
			"MultiEdit",
			"Glob",
			"Grep"
		],
		"deny": [
			"Bash(rm -rf /)",
			"Bash(rm -rf ~)",
			"Bash(rm -rf .)",
			"Bash(rm -rf *)",
			"Bash(git push --force main)",
			"Bash(git push --force master)",
			"Bash(curl *)",
			"Bash(wget *)",
			"Read(.env)",
			"Read(.env.*)",
			"Read(.env.local)",
			"Read(.env.production)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/bash-firewall.sh"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-checks.sh"
					}
				]
			}
		]
	}
}
